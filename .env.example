# Copy to .env for a self-hosted API. No production credentials are included.
# Frontend-only preview does not require this file or any cloud account.
APP_MODE=web
DATABASE_URL=postgresql+psycopg2://vizuai:local-development-only@127.0.0.1:5432/vizuai
WEB_PUBLIC_URL=http://localhost:5173
WEB_APP_URL=http://localhost:5173
WEB_API_URL=http://localhost:8080
WEB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEB_RATE_LIMIT_ENABLED=false
REDIS_URL=

# Required API settings. Replace with resources in your own project.
VERTEX_PROJECT_ID=your-gcp-project
VERTEX_LOCATION=us-central1
GCS_BUCKET=your-gcs-bucket
CDN_URL_TEMPLATE=https://storage.googleapis.com/your-gcs-bucket/{key}
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repository/credentials.json
# GCS_CREDENTIALS_PATH=/absolute/path/outside/repository/credentials.json
S3_PRESIGN_INPUTS=true
S3_PRESIGN_EXPIRES=3600

# Worker: switch APP_MODE to worker and supply your own provider keys.
OPENAI_API_KEY=
SEARCHAPI_KEY=
DECOR8_API_KEY=
GEMINI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.2
OPENAI_IMAGE_MODEL=gpt-image-1.5
GEMINI_MODEL=gemini-2.5-pro

# Job dispatch requires a queue and worker that you provision yourself.
CLOUD_TASKS_PROJECT_ID=your-gcp-project
CLOUD_TASKS_LOCATION=europe-west1
CLOUD_TASKS_QUEUE=web-jobs
CLOUD_TASKS_WORKER_URL=
CLOUD_TASKS_SERVICE_ACCOUNT=
CLOUD_TASKS_REQUEST_SECRET=

# Email login is disabled until a real delivery provider is configured.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
AUTH_MAGIC_LINK_TTL_MINUTES=20
AUTH_SESSION_TTL_DAYS=30

# Billing is disabled until your own merchant credentials are configured.
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_RECEIPT_ENABLED=false

# Legacy Telegram interface is optional.
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_CHAT_IDS=
